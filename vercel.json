{
  "redirects": [
    {
      "source": "/renting-form",
      "has": [
        { "type": "host", "value": "(www\\.)?homequest\\.io" }
      ],
      "destination": "https://www.hqhousing.com/renting-form",
      "permanent": true
    },
    {
      "source": "/buying-form",
      "has": [
        { "type": "host", "value": "(www\\.)?homequest\\.io" }
      ],
      "destination": "https://www.hqhousing.com/buying-form",
      "permanent": true
    },
    {
      "source": "/form",
      "has": [
        { "type": "host", "value": "(www\\.)?homequest\\.io" }
      ],
      "destination": "https://www.hqhousing.com/form",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "(www\\.)?homequest\\.io" }
      ],
      "destination": "https://www.hqhousing.com/",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/renting-form", "destination": "/index.html" },
    { "source": "/buying-form", "destination": "/index.html" },
    { "source": "/form", "destination": "/index.html" }
  ]
}
